{
  "name": "@forgedevstack/bear-icons",
  "version": "1.0.3",
  "description": "SVG icon library for Bear UI and ForgeStack. 550+ React icons, no component library required.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./action": {
      "types": "./dist/action.d.ts",
      "import": "./dist/action.js",
      "require": "./dist/action.cjs"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js",
      "require": "./dist/navigation.cjs"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js",
      "require": "./dist/content.cjs"
    },
    "./communication": {
      "types": "./dist/communication.d.ts",
      "import": "./dist/communication.js",
      "require": "./dist/communication.cjs"
    },
    "./status": {
      "types": "./dist/status.d.ts",
      "import": "./dist/status.js",
      "require": "./dist/status.cjs"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js",
      "require": "./dist/media.cjs"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "require": "./dist/editor.cjs"
    },
    "./misc": {
      "types": "./dist/misc.d.ts",
      "import": "./dist/misc.js",
      "require": "./dist/misc.cjs"
    },
    "./bear": {
      "types": "./dist/bear.d.ts",
      "import": "./dist/bear.js",
      "require": "./dist/bear.cjs"
    },
    "./file": {
      "types": "./dist/file.d.ts",
      "import": "./dist/file.js",
      "require": "./dist/file.cjs"
    },
    "./social": {
      "types": "./dist/social.d.ts",
      "import": "./dist/social.js",
      "require": "./dist/social.cjs"
    },
    "./device": {
      "types": "./dist/device.d.ts",
      "import": "./dist/device.js",
      "require": "./dist/device.cjs"
    },
    "./commerce": {
      "types": "./dist/commerce.d.ts",
      "import": "./dist/commerce.js",
      "require": "./dist/commerce.cjs"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js",
      "require": "./dist/charts.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/node": "^22.10.7",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0"
  },
  "keywords": [
    "react",
    "icons",
    "svg",
    "bear",
    "forgestack",
    "ui"
  ],
  "author": "John Yaghobieh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yaghobieh/bear-icons"
  },
  "homepage": "https://bearui.com/icons",
  "bugs": {
    "url": "https://github.com/yaghobieh/bear-icons/issues"
  }
}
